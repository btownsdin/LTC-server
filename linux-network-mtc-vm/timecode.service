[Unit]
Description=Network MTC Timecode Server (Mac LTC->MTC via rtpmidid)
After=network-online.target rtpmidid.service
Wants=network-online.target
Requires=rtpmidid.service

[Service]
Type=simple
WorkingDirectory=/opt/timecode
ExecStart=/usr/bin/node /opt/timecode/server.js
Restart=always
RestartSec=3

# --- Tune these ---
# PORT:          the port the dashboard is served on.
# MIDI_PORT_NAME: substring to match the rtpmidid ALSA port name.
#                 Run `aconnect -i` after the Mac connects to see the exact name,
#                 then set it here for a precise match instead of the built-in guesses.
Environment=PORT=8085
Environment=MIDI_PORT_NAME=

[Install]
WantedBy=multi-user.target
